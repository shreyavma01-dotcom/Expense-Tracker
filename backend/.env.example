# Backend environment (copy to .env and fill in real values)

# "production" enables strict validation: JWT_SECRET and CORS_ORIGIN become
# mandatory, and insecure dev fallbacks are refused.
NODE_ENV=development

# Server port (defaults to 5001)
PORT=5001

# PostgreSQL connection.
# Option A: full connection string (recommended for production, e.g. Neon/Supabase/Render)
DATABASE_URL=
# Set to "require" if your provider enforces TLS
PGSSL=

# Option B: discrete values (local development defaults)
PGUSER=postgres
PGHOST=localhost
PGDATABASE=expense_tracker
PGPASSWORD=
PGPORT=5432

# Secret used to sign JWTs. REQUIRED in production.
# Generate e.g. with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated list of allowed frontend origins, e.g. https://your-frontend.example.com
# REQUIRED in production. Unset allows all origins (development only).
CORS_ORIGIN=

# Optional overrides for the demo seed users (npm run seed only)
DEMO_ADMIN_PASSWORD=
DEMO_USER_PASSWORD=

